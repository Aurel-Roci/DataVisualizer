{
  "name": "bloodwork-dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "oxfmt src/"
  },
  "dependencies": {
    "chart.js": "^4.6.1",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.46",
    "vue-chartjs": "^5.3.7",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@tsconfig/node26": "^26.0.2",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.94.0",
    "eslint-plugin-vue": "~10.12.1",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^9.1.0",
    "oxfmt": "^0.79.0",
    "oxlint": "~1.94.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.8",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=26.12.0"
  }
}
