# .env.example
# Copy this to .env and update values as needed

# InfluxDB 3 Configuration
INFLUXDB_HOST=http://localhost:8181
INFLUXDB_TOKEN=your-admin-token-here
INFLUXDB_DATABASE=bloodwork

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# Comma-separated origins allowed by CORS (the Vue app)
CORS_ORIGINS=http://localhost:5173

# Patient name used when an upload has none (keep it constant across a backfill)
DEFAULT_PATIENT_NAME=unknown

# File Upload Configuration
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_EXTENSIONS=pdf